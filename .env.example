# Источник остатков — фид 1С
SOURCE_XML_URL=https://centermatrasov.kz/kspmat/kaspi_catalog.xml

# --- Цены. Вариант 1: закрытая Google-таблица (боевой) ---
# Таблица НЕ публикуется, ей выдаётся доступ «Просмотр» сервисному аккаунту.
# PRICES_SHEET_ID=1rWeeFVrzumdnuK7ym4kcNAxGzeKDoYSOZAbErKMeP8Y
# PRICES_SHEET_RANGE=A:Z
# GOOGLE_SERVICE_ACCOUNT_JSON=<содержимое JSON-ключа или он же в base64>

# --- Цены. Вариант 2: CSV (локальная разработка) ---
PRICES_CSV_URL=data/prices.csv

# Порт и период пересборки сервиса
PORT=8080
REBUILD_MINUTES=15

# Магазин матрасов (Centersna)
MERCHANT_ID_MATRAS=Centersna
COMPANY_MATRAS=Centersna
CENTERSNA_STORE=Centersna_PP1
CENTERSNA_SOURCE_STORES=PP2
CENTERSNA_CITIES=750000000

# Магазин кроватей и всего остального
MERCHANT_ID_OTHER=30378397

# Потолок остатка в выгрузке, 0 = не ограничивать
STOCK_CAP=0

# Архив кабинета Centersna (снятые с продажи товары). URL или локальный файл.
# По умолчанию data/archive-centersna.xml; нет файла — собираем без архива.
ARCHIVE_XML_URL=data/archive-centersna.xml
